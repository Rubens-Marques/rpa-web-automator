{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 scripts/nexus_cursor_hook.py sessionStart"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 scripts/nexus_cursor_hook.py preToolUse"
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/nexus_cursor_hook.py stop"
      }
    ],
    "preCompact": [
      {
        "command": "python3 scripts/nexus_cursor_hook.py preCompact"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 scripts/nexus_cursor_hook.py sessionEnd"
      }
    ]
  }
}
